{
  "uid": "service-digest",
  "title": "Сводки дежурного — ShopTeam",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Обработанные сводки по сценарию и результату",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "digest-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "expr": "sum by (scenario,status) (digest_runs_total)",
          "legendFormat": "{{scenario}} {{status}} {{tool}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Время подготовки сводки, p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "digest-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(digest_duration_seconds_bucket[5m])))",
          "legendFormat": "{{scenario}} {{status}} {{tool}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Технические ошибки подготовки сводки, %",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "digest-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "expr": "100 * (sum(rate(digest_runs_total{status=\"error\"}[5m])) or vector(0)) / clamp_min(sum(rate(digest_runs_total[5m])), 0.000001)",
          "legendFormat": "{{scenario}} {{status}} {{tool}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Вызовы MCP-инструментов",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "digest-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "expr": "sum by (tool,status) (digest_tool_calls_total)",
          "legendFormat": "{{scenario}} {{status}} {{tool}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    }
  ]
}